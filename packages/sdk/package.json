{
  "name": "@kaana.ai/sdk",
  "version": "1.0.1",
  "description": "The TypeScript client of Kaana's public API at https://kaana.ai/v1: models, power levels, responses, chat completions, embeddings, speech, transcription, images, decisions, generation records and realtime sessions. Runs in Node, browsers and React Native.",
  "type": "module",
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://kaana.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Kaana.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@kaana.ai/contracts": "workspace:*"
  }
}
