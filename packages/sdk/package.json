{
  "name": "@kaana.ai/sdk",
  "version": "3.3.0",
  "description": "The TypeScript client of Kaana's public API at https://kaana.ai/v1: models, power levels, responses, chat completions, embeddings, speech, transcription, images, decisions, generation records and realtime sessions. Runs in Node, browsers and React Native.",
  "type": "module",
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://kaana.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Kaana.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "NOTICE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@kaana.ai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@oxy.so/core": "6.15.1",
    "kaana-contracts-4.4.0": "npm:@kaana.ai/contracts@4.4.0",
    "kaana-contracts-4.4.1": "npm:@kaana.ai/contracts@4.4.1",
    "kaana-contracts-5.0.0": "npm:@kaana.ai/contracts@5.0.0",
    "kaana-sdk-1.0.1": "npm:@kaana.ai/sdk@1.0.1"
  }
}
